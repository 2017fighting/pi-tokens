{
  "name": "pi-tokens",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "tokens",
    "usage",
    "cost"
  ],
  "repository": {
