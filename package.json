    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.10",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
